# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas connection string (required)
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/whatsapp-bookkeeping?retryWrites=true&w=majority
MONGODB_URI=

# Google AI Studio (Gemini)
# NOTE: the Gemini 2.0 family (previously used in this example) was shut
# down by Google on June 1, 2026 — any request to it now 404s. "-latest"
# aliases point at Google's current GA fast/lite model instead, so this
# stays correct across model-generation changes. See
# src/services/ai/geminiClient.js for the curated fallback list
# GeminiAIService uses if the primary model fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_CLASSIFIER_MODEL=gemini-flash-lite-latest
GEMINI_PARSER_MODEL=gemini-flash-latest

# Classification / queries
CLASSIFICATION_MIN_CONFIDENCE=0.7
# Per-attempt AI request timeout. Keep this short (a real available
# flash/flash-lite model answers in 1-3s) — see AI_TOTAL_BUDGET_MS below.
AI_TIMEOUT_MS=4000
# Total wall-clock budget for one AI call INCLUDING every curated fallback
# model attempt. Must stay short enough that concurrencyLocks.js's
# derived lock TTL (this value + 30000ms) doesn't leave a user's chat
# blocked for an unreasonable stretch if the AI provider is down.
AI_TOTAL_BUDGET_MS=9000
QUERY_LAST_N=5
GEMINI_QUERY_MODEL=gemini-flash-latest

# Timeouts (milliseconds)
DOWNLOAD_TIMEOUT_MS=30000
TRANSCRIPTION_TIMEOUT_MS=60000

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_API_TIMEOUT_MS=30000
WHATSAPP_API_MAX_RETRIES=3
